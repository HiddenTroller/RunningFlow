+// Python API 대신 가짜 fetch와 최소 DOM을 사용한 화면 확인 흐름 테스트.
+const vm = require('node:vm');
+const fs = require('node:fs');
+const assert = require('node:assert/strict');
+const elements = new Map();
+function element(id) {
+  if (!elements.has(id)) elements.set(id, {textContent:'',innerHTML:'',hidden:false,disabled:false,checked:false,value:'single',dataset:{},open:false,
+    scrollIntoView(){},showModal(){this.open=true;},close(){this.open=false;}});
+  return elements.get(id);
+}
+const requests=[];
+const statusRequests=[];
+let answer={};
+const context={console, Blob, URL, setTimeout,
+  document:{querySelector:element,querySelectorAll:()=>[],createElement:()=>({click(){}})},
+  fetch:async(path,init)=>{
+    if(path==='/api/status'){statusRequests.push(init);return {json:async()=>({token:'test',config_policy:'latest'})};}
+    requests.push({path,data:JSON.parse(init.body)});
+    return {ok:true,json:async()=>answer};
+  }};
+vm.createContext(context);
+vm.runInContext(fs.readFileSync('static/app.js','utf8'),context);
+(async()=>{
+  const candidate={candidate_id:'candidate-test',product:{ITEM_SEQ:'123',ITEM_NAME:'가상 제품'},comparison:{status:'확인 필요',calculation_ready:true,warnings:[],rows:[{name:'가상 성분',status:'함량 불일치',photo:{strength:{raw:'650mg',mg:'650'}},official:{strength:{raw:'500mg',mg:'500'}}}]}};
+  context.fixture=candidate;
+  vm.runInContext('candidates=[fixture];selectCandidate(0)',context);
+  vm.runInContext('renderPhotoSummary({product_name_raw:"현재 제품",dosage_and_administration:"새 용법 원문",effective_ingredients:[{ingredient_name:"성분A",strength_per_unit:"1정 중 500mg"}]},{config_policy:"latest",selected_model:"step_extract"})',context);
+  assert(element('#photoSummary').innerHTML.includes('새 용법 원문'));
+  assert(element('#photoSummary').innerHTML.includes('1정 중 500mg'));
+  assert(element('#analysisVersion').textContent.includes('step_extract'));
+  assert.equal(vm.runInContext('basket.length',context),0,'후보 선택만으로 추가 금지');
+  element('#reviewed').checked=true;
+  await element('#addProduct').onclick();
+  assert.equal(element('#mismatchDialog').open,true,'불일치 추가 확인 모달');
+  assert.equal(requests.length,0,'추가 확인 전 서버 승인 요청 금지');
+  await element('#mismatchAccept').onclick();
+  assert.equal(requests.length,0,'추가 체크 없으면 요청 금지');
+  element('#mismatchReviewed').checked=true;
+  answer={approval_id:'approval-test',product:{code:'123',name:'가상 제품',quantity:0,quantity_unit:'정',ingredients:[{name:'공식 성분',amount:'500'}]}};
