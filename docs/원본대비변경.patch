+        result=select_output({'output':[step('step_parse','{}'),step('step_Extract','{"product_name_raw":"Extract"}'),step('instruct','{"product_name_raw":"Instruct"}')]})
+        self.assertEqual(result[1]['product_name_raw'],'Extract')
